# Discord Bot
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dayz-bot

# DayZ Server
DAYZ_SERVER_IP=your_dayz_server_ip
DAYZ_SERVER_PORT=2302
DAYZ_RCON_PASSWORD=your_rcon_password

# izurvive API
IZURVIVE_API_KEY=your_izurvive_api_key
IZURVIVE_API_URL=https://izurvive.com/api

# Bot Settings
NODE_ENV=production
PREFIX=/
DEFAULT_LANGUAGE=en